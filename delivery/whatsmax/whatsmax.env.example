# Fresh private WhatsMax install. Copy OUTSIDE the public repository, chmod 600,
# and inject the same runtime settings into web, worker and scheduler.
APP_NAME=WhatsMax
APP_URL=https://replace-with-whatsmax-host
NEXTAUTH_URL=https://replace-with-whatsmax-host
APP_ENV=production
APP_DEMO_MODE=false
SEED_DEMO_DATA=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# openssl rand -base64 32; never paste secrets in chat or commit them.
AUTH_SECRET=
AUTH_TRUST_HOST=true
# openssl rand -hex 32; retain this key across redeployments and backups.
APP_ENCRYPTION_KEY=
DATABASE_URL=
REDIS_URL=

# Configure a deliverable sender before invitation/reset email acceptance tests.
MAIL_TRANSPORT=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Dojang

# local requires persistent shared public/uploads and public/branding storage.
STORAGE_DRIVER=local
WHATSAPP_QR_ENABLED=false
TRUSTED_PROXY_HOPS=1

# Keep the purchased application's own license settings/setup intact.
# Provider accounts and API workspace tokens are configured after installation.
