# Separate private runtime configuration for the signed inbound polling job.
# This contains no WhatsMax DB/admin credentials and no frontend-public keys.
DOJANG_HUB_WHATSMAX_ORIGIN=https://replace-with-whatsmax-host
DOJANG_HUB_WHATSMAX_TOKEN=
DOJANG_HUB_WORKSPACE_ID=
DOJANG_HUB_ODOO_ORIGIN=https://replace-with-odoo-host
DOJANG_HUB_SITE_ID=
DOJANG_HUB_WEBHOOK_SECRET=
# Set once to an ISO timestamp WITH timezone; keep it fixed on later runs.
DOJANG_HUB_SYNC_SINCE=
DOJANG_HUB_SYNC_STATE=/private/roster-hub-sync.sqlite
# Change only after the real provider callback authentication is verified.
DOJANG_HUB_PROVIDER_INGRESS_VERIFIED=false
