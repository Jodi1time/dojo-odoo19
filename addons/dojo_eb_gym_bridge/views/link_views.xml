<odoo>
  <record id="gym_link_form" model="ir.ui.view">
    <field name="name">dojo.gym.link.form</field><field name="model">dojo.gym.link</field>
    <field name="arch" type="xml"><form><sheet><group>
      <field name="member_id"/><field name="membership_id"/><field name="company_id"/><field name="active"/>
      <field name="template_ids" widget="many2many_tags"/>
    </group></sheet></form></field>
  </record>
  <record id="gym_link_action" model="ir.actions.act_window"><field name="name">EB Gym Mappings</field><field name="res_model">dojo.gym.link</field><field name="view_mode">list,form</field></record>
  <menuitem id="gym_link_menu" name="EB Gym Mappings" parent="dojo_companion_hub.hub_menu" action="gym_link_action" groups="base.group_system"/>
</odoo>
